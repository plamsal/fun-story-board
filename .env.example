# Copy this file to ".env". Never commit ".env".

# Your Claude API key. This line reads it from an environment variable named
# STORY_KEY (use capitals: Windows only knows the capital form). You can also
# paste the key here directly instead. Leave empty to get placeholder stories.
ANTHROPIC_API_KEY=${STORY_KEY}

# Optional settings (defaults shown)
# ANTHROPIC_MODEL=claude-sonnet-5-5
# STORY_TIMEZONE=America/New_York
# DB_PATH=data/stories.db

# A long secret you choose (12+ characters). It opens the admin page at /admin.
# Leave empty and there is no admin page.
# ADMIN_KEY=

# Optional: shown on the privacy page so people can ask for answers to be removed.
# CONTACT_EMAIL=

# Only on the host: a Postgres connection string. When set, it is used instead
# of the local SQLite file.
# DATABASE_URL=
